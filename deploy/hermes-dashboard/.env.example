# Copy to .env next to compose.yaml. chmod 600. Never commit.

# Image: ghcr.io/<owner>/rals-hermes. Pin IMAGE_TAG to a commit SHA in
# production; "latest" only for the first bring-up.
IMAGE_OWNER=rals-dev
IMAGE_TAG=<sha from CI>

# Traefik host rule on the Tailscale entrypoint, following the existing
# pattern (<service>.srv01-rals.<tailnet>.ts.net).
DASHBOARD_HOST=dashboard.srv01-rals.<tailnet>.ts.net

LOG_LEVEL=info

# The dashboard login secret: openssl rand -hex 32
BFF_API_KEY=

# One API_SERVER_KEY per Hermes profile (from /srv/data/hermes/.env and
# /srv/data/hermes/profiles/<profile>/.env).
HERMES_KEY_DEFAULT=
HERMES_KEY_CODER=
HERMES_KEY_TESTER=
HERMES_KEY_PRODUCT=
